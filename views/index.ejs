<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chess Game</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: #18181b;
            color: #ffffff;
            font-family: Arial, sans-serif;
        }

        .page-layout {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 24px 16px;
        }

        .top-panel {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 8px;
            margin-bottom: 24px;
        }

        #role-label {
            margin: 0;
            font-size: 30px;
            font-weight: 700;
            line-height: 1.2;
        }

        #role-detail {
            margin: 0;
            color: #d4d4d8;
            font-size: 15px;
        }

        .scoreboard {
            display: flex;
            align-items: stretch;
            justify-content: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 8px;
        }

        .score-card {
            min-width: 150px;
            padding: 12px 18px;
            border: 1px solid #52525b;
            border-radius: 10px;
            background: #27272a;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        .score-name {
            color: #e4e4e7;
            font-size: 14px;
        }

        .score-value {
            font-size: 24px;
            font-weight: 700;
            color: #facc15;
            font-variant-numeric: tabular-nums;
        }

        .score-unit {
            color: #a1a1aa;
            font-size: 12px;
        }

        .score-description {
            margin: 0;
            color: #a1a1aa;
            font-size: 12px;
        }

        .chessboard {
            display: grid;
            grid-template-columns: repeat(8, minmax(0, 1fr));
            grid-template-rows: repeat(8, minmax(0, 1fr));
            width: min(400px, 92vw);
            aspect-ratio: 1;
            transform: rotate(0deg);
            flex: 0 0 auto;
        }

        .piece.white {
            color: white;
            filter: drop-shadow(0 0 2px rgba(0, 0, 0, 1));
        }

        .piece.black {
            color: black;
        }

        .flipped {
            transform: rotate(180deg);
        }

        .square {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            cursor: pointer;
        }

        .square.selected {
            box-shadow: inset 0 0 0 4px rgba(250, 204, 21, 0.95);
        }

        .square.possible-move::after {
            content: "";
            position: absolute;
            width: 24%;
            height: 24%;
            border-radius: 50%;
            background: rgba(22, 101, 52, 0.58);
            pointer-events: none;
            z-index: 0;
        }

        .square.possible-capture::after {
            content: "";
            position: absolute;
            inset: 6%;
            border: 5px solid rgba(22, 101, 52, 0.62);
            border-radius: 50%;
            box-sizing: border-box;
            pointer-events: none;
            z-index: 0;
        }

        .square.light {
            background-color: #f0d9b5;
        }

        .square.dark {
            background-color: #b58863;
        }

        .piece {
            position: relative;
            z-index: 1;
            font-size: clamp(24px, 8vw, 36px);
            cursor: pointer;
            user-select: none;
        }

        .piece.draggable {
            cursor: grab;
        }

        .dragging {
            opacity: 0.5;
        }

        .flipped .piece {
            transform: rotate(180deg);
        }
    </style>
</head>
<body>
    <main class="page-layout">
        <header class="top-panel">
            <h1 id="role-label">Connecting...</h1>
            <p id="role-detail">Connecting to the chess game</p>

            <section class="scoreboard" aria-label="Captured material score">
                <div class="score-card">
                    <span class="score-name">Player 1 · White</span>
                    <strong class="score-value" id="white-score">0</strong>
                    <span class="score-unit">points</span>
                </div>

                <div class="score-card">
                    <span class="score-name">Player 2 · Black</span>
                    <strong class="score-value" id="black-score">0</strong>
                    <span class="score-unit">points</span>
                </div>
            </section>

            <p class="score-description">
                Material points are awarded for captured pieces.
            </p>
        </header>

        <div class="chessboard bg-red-800" aria-label="Chessboard"></div>
    </main>

    <script src="/socket.io/socket.io.js"></script>

    <script
        src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"
        integrity="sha512-xRllwz2gdZciIB+AkEbeq+gVhX8VB8XsfqeFbUh+SzHlN96dEduwtTuVuc2u9EROlmW9+yhRlxjif66ORpsgVA=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer">
    </script>

    <script src="/js/chessgame.js"></script>
</body>
</html>